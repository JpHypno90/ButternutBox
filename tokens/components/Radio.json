{
  "radio": {
    "colour": {
      "control": {
        "border": {
          "default": {
            "$type": "color",
            "$value": "{colour.background.action.secondary.selected}"
          },
          "selected": {
            "$type": "color",
            "$value": "{colour.border.action.default}"
          }
        }
      },
      "indicator": {
        "background": {
          "default": {
            "$type": "color",
            "$value": "{colour.background.surface.default}"
          },
          "selected": {
            "$type": "color",
            "$value": "{colour.background.action.primary.default}"
          }
        }
      },
      "text": {
        "title": {
          "$type": "color",
          "$value": "{colour.text.primary}"
        },
        "subtext": {
          "$type": "color",
          "$value": "{colour.text.secondary}"
        }
      }
    },
    "borderWidth": {
      "default": {
        "$type": "borderWidth",
        "$value": "{borderWidth.md}"
      }
    },
    "size": {
      "control": {
        "default": {
          "$type": "sizing",
          "$value": "{dimension.sizing.28}"
        }
      },
      "indicator": {
        "default": {
          "$type": "sizing",
          "$value": "{sizing.lg}"
        }
      }
    },
    "spacing": {
      "gap": {
        "$type": "spacing",
        "$value": "{spacing.sm}"
      },
      "content": {
        "gap": {
          "$type": "spacing",
          "$value": "{spacing.2xs}"
        }
      }
    }
  },
  "radioTile": {
    "size": {
      "maxWidth": {
        "$type": "sizing",
        "$value": "{dimension.sizing.500}"
      }
    },
    "illustration": {
      "size": {
        "default": {
          "$type": "sizing",
          "$value": "{sizing.8xl}"
        }
      }
    },
    "spacing": {
      "verticalPadding": {
        "$type": "spacing",
        "$value": "{spacing.md}"
      },
      "horizontalPadding": {
        "$type": "spacing",
        "$value": "{spacing.md}"
      },
      "gap": {
        "$type": "spacing",
        "$value": "{spacing.xs}"
      }
    },
    "colour": {
      "background": {
        "default": {
          "$type": "color",
          "$value": "{colour.background.container.default}"
        },
        "selected": {
          "$type": "color",
          "$value": "{colour.text.action.inverse}"
        }
      },
      "border": {
        "default": {
          "$type": "color",
          "$value": "{colour.border.input.default}"
        },
        "hover": {
          "$type": "color",
          "$value": "{colour.border.action.hover}"
        },
        "selected": {
          "$type": "color",
          "$value": "{colour.border.action.selected}"
        }
      }
    },
    "borderWidth": {
      "default": {
        "$type": "borderWidth",
        "$value": "{borderWidth.sm}"
      },
      "hover": {
        "$type": "borderWidth",
        "$value": "{borderWidth.md}"
      },
      "selected": {
        "$type": "borderWidth",
        "$value": "{borderWidth.md}"
      }
    },
    "borderRadius": {
      "default": {
        "$type": "borderRadius",
        "$value": "{borderRadius.md}"
      }
    },
    "boxShadow": {
      "default": {
        "$type": "boxShadow",
        "$value": "{shadow.sm}"
      }
    }
  },
  "switch": {
    "typography": {
      "label": {
        "$type": "typography",
        "$value": "{typography.body.semiBold.lg}"
      },
      "subText": {
        "$type": "typography",
        "$value": "{typography.body.medium.md}"
      }
    }
  }
}