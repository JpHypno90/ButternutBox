{
  "modal": {
    "modalHeader": {
      "spacing": {
        "padding": {
          "$type": "spacing",
          "$value": "{spacing.xl}",
          "$description": "24px — outer padding all variants"
        },
        "content": {
          "gap": {
            "$type": "spacing",
            "$value": "{spacing.3xs}",
            "$description": "2px — title to description gap"
          }
        },
        "section": {
          "gap": {
            "$type": "spacing",
            "$value": "{spacing.xl}",
            "$description": "24px — container to inline-alert gap (Full bleed)"
          }
        }
      },
      "colour": {
        "text": {
          "title": {
            "$type": "color",
            "$value": "{colour.text.primary}",
            "$description": "#522A10"
          },
          "description": {
            "$type": "color",
            "$value": "{colour.text.secondary}",
            "$description": "#633F28"
          }
        },
        "background": {
          "fullBleed": {
            "$type": "color",
            "$value": "{colour.background.container.secondary}",
            "$description": "#FFF6D8 — Full bleed variant background"
          }
        }
      },
      "borderRadius": {
        "image": {
          "default": {
            "$type": "borderRadius",
            "$value": "{borderRadius.sm}",
            "$description": "8px — image frame corners"
          }
        }
      },
      "typography": {
        "title": {
          "$type": "typography",
          "$value": "{typography.heading.desktop.md}",
          "$description": "Heading font 700, fontSize 24, lineHeight 28"
        },
        "description": {
          "$type": "typography",
          "$value": "{typography.body.medium.md}",
          "$description": "Body font 500, fontSize 16, lineHeight 24"
        }
      }
    },
    "content": {
      "spacing": {
        "horizontalPadding": {
          "$type": "spacing",
          "$value": "{spacing.xl}"
        },
        "gap": {
          "$type": "spacing",
          "$value": "{spacing.2xl}"
        },
        "bottomPadding": {
          "$type": "spacing",
          "$value": "{spacing.xl}"
        }
      }
    },
    "borderRadius": {
      "default": {
        "$type": "borderRadius",
        "$value": "{borderRadius.md}"
      }
    },
    "background": {
      "default": {
        "$type": "color",
        "$value": "{colour.background.container.default}"
      }
    }
  }
}