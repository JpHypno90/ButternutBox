{
  "buttons": {
    "text": {
      "primary": {
        "default": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{fontFamily.brand.butternutbox.headings}",
            "fontWeight": "{fontWeight.700}",
            "fontSize": "{fontSize.18}",
            "lineHeight": "{lineHeight.20}"
          }
        }
      }
    },
    "size": {
      "lg": {
        "height": {
          "$type": "sizing",
          "$value": "{dimension.sizing.52}"
        },
        "minWidth": {
          "$type": "sizing",
          "$value": "{dimension.sizing.60}"
        }
      },
      "md": {
        "height": {
          "$type": "sizing",
          "$value": "{dimension.sizing.44}"
        },
        "minWidth": {
          "$type": "sizing",
          "$value": "{dimension.sizing.60}"
        }
      },
      "sm": {
        "height": {
          "$type": "sizing",
          "$value": "{dimension.sizing.36}"
        },
        "minWidth": {
          "$type": "sizing",
          "$value": "{dimension.sizing.60}"
        }
      }
    },
    "spacing": {
      "lg": {
        "horizontalPadding": {
          "$type": "spacing",
          "$value": "{spacing.xl}"
        },
        "verticalPadding": {
          "$type": "spacing",
          "$value": "{spacing.md}"
        },
        "gap": {
          "$type": "spacing",
          "$value": "{spacing.2xs}"
        }
      },
      "md": {
        "horizontalPadding": {
          "$type": "spacing",
          "$value": "{spacing.lg}"
        },
        "verticalPadding": {
          "$type": "spacing",
          "$value": "{spacing.sm}"
        },
        "gap": {
          "$type": "spacing",
          "$value": "{spacing.2xs}"
        }
      },
      "sm": {
        "horizontalPadding": {
          "$type": "spacing",
          "$value": "{spacing.md}"
        },
        "verticalPadding": {
          "$type": "spacing",
          "$value": "{spacing.xs}"
        },
        "gap": {
          "$type": "spacing",
          "$value": "{spacing.2xs}"
        }
      }
    },
    "borderRadius": {
      "default": {
        "$type": "borderRadius",
        "$value": "{borderRadius.round}"
      }
    },
    "opacity": {
      "disabled": {
        "$type": "opacity",
        "$value": "{opacity.50}"
      }
    },
    "filledButton": {
