{
  "primaryTab": {
    "tabitem": {
      "size": {
        "height": {
          "$type": "sizing",
          "$value": "{sizing.6xl}"
        },
        "minWidth": {
          "$type": "sizing",
          "$value": "{dimension.sizing.76}"
        }
      }
    },
    "tabItem": {
      "spacing": {
        "horizontalPadding": {
          "$type": "spacing",
          "$value": "{spacing.sm}"
        },
        "topPadding": {
          "$type": "spacing",
          "$value": "{spacing.xs}"
        },
        "bottomPadding": {
          "$type": "spacing",
          "$value": "{spacing.sm}"
        },
        "gap": {
          "$type": "spacing",
          "$value": "{spacing.xs}"
        }
      },
      "colour": {
        "border": {
          "default": {
            "$type": "color",
            "$value": "{colour.border.action.default}"
          },
          "disabled": {
            "$type": "color",
            "$value": "{colour.system.neutral.3}"
          },
          "hover": {
            "$type": "color",
            "$value": "{colour.brand.brown.7}"
          }
        },
        "text": {
          "default": {
            "$type": "color",
            "$value": "{colour.text.action.default}"
          }
        }
      },
      "borderWidth": {
        "default": {
          "$type": "borderWidth",
          "$value": "{borderWidth.lg}"
        }
      },
      "typography": {
        "selected": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{fontFamily.brand.butternutbox.body}",
            "fontWeight": "{fontWeight.700}",
            "fontSize": "{fontSize.20}",
            "lineHeight": "{lineHeight.24}"
          }
        },
        "default": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{fontFamily.brand.butternutbox.body}",
            "fontWeight": "{fontWeight.600}",
            "fontSize": "{fontSize.20}",
            "lineHeight": "{lineHeight.24}"
          }
        }
      }
    }
  }
}