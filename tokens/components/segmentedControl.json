{
  "controlItem": {
    "size": {
      "small": {
        "height": {
          "$type": "sizing",
          "$value": "{dimension.sizing.36}"
        },
        "minWidth": {
          "$type": "sizing",
          "$value": "{sizing.7xl}"
        }
      }
    },
    "colour": {
      "background": {
        "selected": {
          "$type": "color",
          "$value": "{colour.background.container.default}"
        },
        "hover": {
          "$type": "color",
          "$value": "{colour.brand.pink.9}"
        }
      },
      "text": {
        "selected": {
          "$type": "color",
          "$value": "{colour.brand.pink.8}"
        },
        "unselected": {
          "$type": "color",
          "$value": "{colour.text.alt}"
        }
      }
    },
    "spacing": {
      "horizontalPadding": {
        "$type": "spacing",
        "$value": "{spacing.md}"
      },
      "verticalPadding": {
        "$type": "spacing",
        "$value": "{spacing.sm}"
      }
    },
    "borderRadius": {
      "default": {
        "$type": "borderRadius",
        "$value": "{borderRadius.round}"
      }
    },
    "typography": {
      "label": {
        "default": {
          "$type": "typography",
          "$value": "{typography.body.bold.md}"
        },
        "inactive": {
          "$type": "typography",
          "$value": "{typography.body.medium.md}"
        }
      }
    },
    "opacity": {
      "disabled": {
        "default": {
          "$type": "opacity",
          "$value": "{opacity.50}"
        }
      }
    }
  },
  "segmentedControl": {
    "colour": {
      "background": {
        "default": {
          "$type": "color",
          "$value": "{colour.brand.pink.8}"
        }
      }
    },
    "borderRadius": {
      "default": {
        "$type": "borderRadius",
        "$value": "{borderRadius.round}"
      }
    },
    "spacing": {
      "horizontalPadding": {
        "$type": "spacing",
        "$value": "{spacing.2xs}"
      },
      "verticalPadding": {
        "$type": "spacing",
        "$value": "{spacing.2xs}"
      },
      "gap": {
        "$type": "spacing",
        "$value": "{spacing.2xs}"
      }
    }
  }
}